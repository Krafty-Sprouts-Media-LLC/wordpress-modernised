<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="bootstrap.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    convertDeprecationsToExceptions="true"
>
    <testsuites>
        <testsuite name="harness">
            <directory>harness</directory>
        </testsuite>
        <testsuite name="wordpress">
            <!-- WordPress 7.1.4's own tests, run unmodified. Added area by area. -->
            <file>wordpress-develop/tests/phpunit/tests/actions.php</file>
            <file>wordpress-develop/tests/phpunit/tests/filters.php</file>
            <directory suffix=".php">wordpress-develop/tests/phpunit/tests/hooks</directory>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpListPluck.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpListUtil.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpListFilter.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpListSort.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpFilterObjectList.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpTriggerError.php</file>
            <file>wordpress-develop/tests/phpunit/tests/db.php</file>
            <file>wordpress-develop/tests/phpunit/tests/db/realEscape.php</file>
            <file>wordpress-develop/tests/phpunit/tests/db/charset.php</file>
            <file>wordpress-develop/tests/phpunit/tests/db/dbDelta.php</file>
            <file>wordpress-develop/tests/phpunit/tests/cache.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/isSerialized.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/isSerializedString.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/maybeSerialize.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/wpSlash.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/stripslashesDeep.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/mapDeep.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/escAttr.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/escHtml.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/removeAccents.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/sanitizeKey.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/sanitizeTitle.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/sanitizeTitleWithDashes.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/utf8UriEncode.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/wpBasename.php</file>
            <file>wordpress-develop/tests/phpunit/tests/formatting/wpSpecialchars.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpParseIdList.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpParseList.php</file>
            <file>wordpress-develop/tests/phpunit/tests/date/currentDatetime.php</file>
            <file>wordpress-develop/tests/phpunit/tests/date/currentTime.php</file>
            <file>wordpress-develop/tests/phpunit/tests/date/wpCheckdate.php</file>
            <file>wordpress-develop/tests/phpunit/tests/date/wpTimezone.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/types.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpPostType.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/getPostTypeLabels.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/isPostTypeViewable.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/isPostStatusViewable.php</file>
            <file>wordpress-develop/tests/phpunit/tests/meta/isProtectedMeta.php</file>
            <file>wordpress-develop/tests/phpunit/tests/meta.php</file>
            <file>wordpress-develop/tests/phpunit/tests/meta/deleteMetadata.php</file>
            <file>wordpress-develop/tests/phpunit/tests/meta/registerMeta.php</file>
            <file>wordpress-develop/tests/phpunit/tests/meta/slashes.php</file>
            <file>wordpress-develop/tests/phpunit/tests/meta/updateMetadata.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/getPost.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpPost.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpDeletePost.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpTrashPost.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpUntrashPost.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpPublishPost.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpUniquePostSlug.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/truncatePostSlug.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/getPostParent.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpGetPostParentId.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/meta.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/slashes.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/updatePostCache.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/primePostCaches.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/wpAfterInsertPost.php</file>
            <file>wordpress-develop/tests/phpunit/tests/post/getPostStatus.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/option.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/getOptions.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/updateOption.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/slashes.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/siteOption.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/networkOption.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpAutoloadValuesToAutoload.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpDetermineOptionAutoloadValue.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpLoadAlloptions.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpPrimeOptionCaches.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpPrimeOptionCachesByGroup.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpPrimeNetworkOptionCaches.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpSetOptionAutoload.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpSetOptionAutoloadValues.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpSetOptionsAutoload.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/transient.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/siteTransient.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/registration.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/sanitizeOption.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/userSettings.php</file>
            <file>wordpress-develop/tests/phpunit/tests/option/wpUserSettings.php</file>
        </testsuite>
        <testsuite name="adapted">
            <!-- WordPress tests adapted after a recorded divergence (docs/divergences.md). -->
            <directory suffix=".php">adapted</directory>
        </testsuite>
    </testsuites>
    <groups>
        <!-- As WordPress's own phpunit.xml.dist does for a single site. -->
        <exclude>
            <group>ajax</group>
            <group>ms-files</group>
            <group>ms-required</group>
            <group>external-http</group>
        </exclude>
    </groups>
</phpunit>
