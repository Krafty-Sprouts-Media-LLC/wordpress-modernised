<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="bootstrap.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    convertDeprecationsToExceptions="true"
>
    <testsuites>
        <testsuite name="harness">
            <directory>harness</directory>
        </testsuite>
        <testsuite name="wordpress">
            <!-- WordPress 7.1.4's own tests, run unmodified. Added area by area. -->
            <file>wordpress-develop/tests/phpunit/tests/actions.php</file>
            <file>wordpress-develop/tests/phpunit/tests/filters.php</file>
            <directory suffix=".php">wordpress-develop/tests/phpunit/tests/hooks</directory>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpListPluck.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpListUtil.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpListFilter.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpListSort.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpFilterObjectList.php</file>
            <file>wordpress-develop/tests/phpunit/tests/functions/wpTriggerError.php</file>
            <file>wordpress-develop/tests/phpunit/tests/db.php</file>
            <file>wordpress-develop/tests/phpunit/tests/db/realEscape.php</file>
            <file>wordpress-develop/tests/phpunit/tests/db/charset.php</file>
        </testsuite>
        <testsuite name="adapted">
            <!-- WordPress tests adapted after a recorded divergence (docs/divergences.md). -->
            <directory suffix=".php">adapted</directory>
        </testsuite>
    </testsuites>
</phpunit>
